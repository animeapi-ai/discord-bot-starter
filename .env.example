# Discord bot token: https://discord.com/developers/applications → your app → Bot → Reset Token
DISCORD_TOKEN=

# AnimeAPI key (starts with ank_): https://animeapi.ai/dashboard/api-keys
ANIMEAPI_KEY=

# Optional. Your server's ID: /anime then shows up there immediately.
GUILD_ID=

# Optional settings (these are the defaults)
ANIMEAPI_MODEL=anime
ANIMEAPI_ORIENTATION=portrait
COOLDOWN_SECONDS=30
